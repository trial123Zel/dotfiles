{{- /* macOS hosts ship the standalone docker-compose binary, not the compose plugin */ -}}
{{ $dc := "docker compose" }}{{ if eq .chezmoi.os "darwin" }}{{ $dc = "docker-compose" }}{{ end -}}
alias dc='{{ $dc }}'
alias dcup='{{ $dc }} up -d --force-recreate'
alias dcdown='{{ $dc }} down'
alias dclogs='{{ $dc }} logs -f'
alias dcpull='{{ $dc }} pull'
alias dcps='{{ $dc }} ps'
alias dps='docker ps'
alias dcex='docker exec -it'
alias dcdev='{{ $dc }} -f docker-compose.dev.yml'

{{ if eq .chezmoi.os "darwin" -}}
alias update='brew update && brew upgrade && brew cleanup'
alias drink='update'
alias ll='ls -lah'
alias ip='ipconfig getifaddr en0 && curl ifconfig.me'
{{- else if eq .chezmoi.osRelease.id "ubuntu" -}}
alias update='sudo apt update && sudo apt upgrade -y && sudo apt autoremove -y'
{{- end }}

export EDITOR=nano
export VISUAL="$EDITOR"

function psa {
    if [[ -z "$1" ]]; then
        ps aux
    else
        ps aux | grep "$@" | grep -v grep
    fi
}

# Connection details live in ~/.pg_service.conf ([tsdb] section), password in ~/.pgpass
tsdb() {
    psql "service=tsdb" -c "$1"
}
